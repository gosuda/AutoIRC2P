# Use compose.portalite.yaml for HTTPS without your own domain or inbound ports.
COMPOSE_FILE=compose.yaml
# Required only for the default Caddy deployment; hostname without scheme/path.
PUBLIC_HOST=

# PORTALITE=1 replaces the local HTTP listener (also for native Go runs).
PORTALITE=0
# Empty generates a unique name on first start; the saved identity is reused.
PORTALITE_NAME=
# Empty uses Portalite's default relays; otherwise comma-separated HTTPS URLs.
PORTALITE_RELAYS=

OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=
OPENAI_MODEL_0=gemma-4-31b-it
OPENAI_MODEL_1=gemma-4-26b-a4b-it
TRANSLATION_INTERVAL=5s
TRANSLATION_COOLDOWN=60s
LISTEN_ADDR=127.0.0.1:8080
APP_ORIGIN=http://localhost:8080
DATA_DIR=data
# Docker bundles the same relative path at /web/build (working directory /).
WEB_DIR=web/build
# Created automatically if missing. Default [tunnel] hops = 1.
IVNP_CONFIG=data/ivnp.conf
IRC_SERVER=irc.postman.i2p:6667
# Set both to authenticate the shared read-only observer with NickServ.
IRC_OBSERVER_NICK=
IRC_OBSERVER_PASSWORD=
IRC_IDLE_TIMEOUT=20m
IRC_PONG_TIMEOUT=2m
IRC_ROOMS='#i2p,#i2p-chat,#saltr,#i2p-dev,#i2pd-dev,#i2pd,#ru,#scanners,#i2p-news,#i2c2p,#salt,#freedom,#i2pd-ru,#go-i2p-dev,#i2people,#ko,#ivnp-dev,#ivnp,#dev,#i2p-design,#i2p-de,#go-i2p'
# Channel joins are paced at one per two seconds per connection.
# IRC_OFFLINE=1 disables router startup for local inspection.

# Only these proxy peers may supply X-Forwarded-For.
# 0.0.0.0/0,::/0 trusts every peer and permits forwarded client-IP spoofing.
TRUSTED_PROXY_CIDRS=
# 0 disables request-rate quotas, not connection/queue caps or provider pacing.
RATE_LIMIT_ENABLED=1
HTTP_BODY_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=150s
WS_MAX_CONNECTIONS=512
WS_MAX_CONNECTIONS_PER_IP=8
WS_MAX_CONNECTIONS_PER_ACCOUNT=4
WS_HANDSHAKES_PER_MINUTE=30
WS_READS_PER_MINUTE=120
SEND_REQUESTS_PER_MINUTE=20
SEND_REQUESTS_PER_IP_MINUTE=60
SEND_MAX_PENDING=32
IRC_MAX_ACCOUNTS=16
IRC_ACCOUNT_IDLE_GRACE=2m

# Zero disables the corresponding retention category.
CHAT_RETENTION=720h
TRANSLATION_RETENTION=720h
SEND_PAYLOAD_RETENTION=720h
RETENTION_INTERVAL=1h
RETENTION_BATCH_SIZE=500
